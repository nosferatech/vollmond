{
  "name": "vollmond",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json && node packages/core/scripts/write-implementation-id.mjs",
    "typecheck": "tsc -p packages/core && tsc -p packages/core/tsconfig.suite.json && tsc -p packages/cli && tsc -p packages/conformance",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run",
    "conformance": "node packages/conformance/dist/main.js"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "fast-check": "4.11.0",
    "typescript": "7.0.2",
    "vitest": "5.1.1"
  }
}
