{
  "defaults": {
    "spec": ["4.1"],
    "profiles": ["read"],
    "operation": "parse",
    "input": { "store": "yaml-constructs" }
  },
  "cases": [
    {
      "id": "infinity",
      "description": ".inf is the core schema's positive infinity (YAML 1.2.2, section 10.3.2), a value outside the data model.",
      "input": { "record": "infinity.yaml" },
      "expect": {
        "fails": true,
        "issues": [{ "code": "yaml-non-finite", "severity": "error", "path": "infinity.yaml", "at": "/a" }]
      }
    },
    {
      "id": "infinity-signs-and-cases",
      "description": "-.inf, +.inf, .Inf and .INF are the core schema's other spellings of infinity (YAML 1.2.2, section 10.3.2), each an error at its node.",
      "input": { "record": "infinity-forms.yaml" },
      "expect": {
        "fails": true,
        "issues": [
          { "code": "yaml-non-finite", "severity": "error", "path": "infinity-forms.yaml", "at": "/a" },
          { "code": "yaml-non-finite", "severity": "error", "path": "infinity-forms.yaml", "at": "/b" },
          { "code": "yaml-non-finite", "severity": "error", "path": "infinity-forms.yaml", "at": "/c" },
          { "code": "yaml-non-finite", "severity": "error", "path": "infinity-forms.yaml", "at": "/d" }
        ]
      }
    },
    {
      "id": "not-a-number",
      "description": ".nan, .NaN and .NAN are the core schema's not-a-number (YAML 1.2.2, section 10.3.2), each an error at its node.",
      "input": { "record": "nan.yaml" },
      "expect": {
        "fails": true,
        "issues": [
          { "code": "yaml-non-finite", "severity": "error", "path": "nan.yaml", "at": "/a" },
          { "code": "yaml-non-finite", "severity": "error", "path": "nan.yaml", "at": "/b" },
          { "code": "yaml-non-finite", "severity": "error", "path": "nan.yaml", "at": "/c" }
        ]
      }
    },
    {
      "id": "infinity-in-a-flow-sequence",
      "description": "A non-finite number inside a sequence is an error at that item.",
      "input": { "record": "non-finite-in-array.yaml" },
      "expect": {
        "fails": true,
        "issues": [{ "code": "yaml-non-finite", "severity": "error", "path": "non-finite-in-array.yaml", "at": "/a/1" }]
      }
    },
    {
      "id": "non-finite-lookalikes-are-strings",
      "description": "A quoted \".inf\", and the plain .iNf, inf, nan and .Nan, match none of the core schema's float forms (YAML 1.2.2, section 10.3.2), so they are strings.",
      "spec": ["4.1", "4.4"],
      "input": { "record": "non-finite-lookalikes.yaml" },
      "expect": { "result": { "a": ".inf", "b": ".iNf", "c": "inf", "d": "nan", "e": ".Nan" } }
    },
    {
      "id": "integer-key",
      "description": "The plain key 1 is an integer in the core schema, so the root mapping has a non-string key; the yaml package's toJS turns it into the string \"1\" (parser survey, section 4.2).",
      "input": { "record": "integer-key.yaml" },
      "expect": {
        "fails": true,
        "issues": [{ "code": "yaml-non-string-key", "severity": "error", "path": "integer-key.yaml", "at": "" }]
      }
    },
    {
      "id": "boolean-key",
      "description": "The plain key true is a boolean in the core schema, a non-string key.",
      "input": { "record": "boolean-key.yaml" },
      "expect": {
        "fails": true,
        "issues": [{ "code": "yaml-non-string-key", "severity": "error", "path": "boolean-key.yaml", "at": "" }]
      }
    },
    {
      "id": "null-key",
      "description": "The plain key ~ is null in the core schema, a non-string key; the yaml package's toJS turns it into the empty string (parser survey, section 4.2).",
      "input": { "record": "null-key.yaml" },
      "expect": {
        "fails": true,
        "issues": [{ "code": "yaml-non-string-key", "severity": "error", "path": "null-key.yaml", "at": "" }]
      }
    },
    {
      "id": "float-key-in-nested-mapping",
      "description": "The plain key 1.5 is a float, so the nested mapping that holds it is the error's node.",
      "input": { "record": "nested-float-key.yaml" },
      "expect": {
        "fails": true,
        "issues": [{ "code": "yaml-non-string-key", "severity": "error", "path": "nested-float-key.yaml", "at": "/m" }]
      }
    },
    {
      "id": "sequence-key",
      "description": "A complex key that is a sequence is not a string.",
      "input": { "record": "sequence-key.yaml" },
      "expect": {
        "fails": true,
        "issues": [{ "code": "yaml-non-string-key", "severity": "error", "path": "sequence-key.yaml", "at": "" }]
      }
    },
    {
      "id": "string-keys",
      "description": "Quoted \"1\", 'true' and \"~\" are strings, and so are the plain keys 2026-10-09 and yes, since the core schema has no dates and no yes (YAML 1.2.2, section 10.3.2), so every key is a string.",
      "spec": ["4.1", "4.4"],
      "input": { "record": "string-keys.yaml" },
      "expect": { "result": { "1": "a", "true": "b", "2026-10-09": "c", "yes": "d", "~": "e" } }
    },
    {
      "id": "anchor-without-alias",
      "description": "An anchor is an error even when no alias uses it.",
      "input": { "record": "anchor.yaml" },
      "expect": {
        "fails": true,
        "issues": [{ "code": "yaml-alias", "severity": "error", "path": "anchor.yaml", "at": "/a" }]
      }
    },
    {
      "id": "anchor-and-alias",
      "description": "The example of the conformance README: the anchor and the alias are each an error at the node that carries it; every YAML reader surveyed expands the alias by default (parser survey, section 4.2).",
      "input": { "record": "anchor-and-alias.yaml" },
      "expect": {
        "fails": true,
        "issues": [
          { "code": "yaml-alias", "severity": "error", "path": "anchor-and-alias.yaml", "at": "/a" },
          { "code": "yaml-alias", "severity": "error", "path": "anchor-and-alias.yaml", "at": "/b" }
        ]
      }
    },
    {
      "id": "anchor-on-a-mapping",
      "description": "An anchor on a block mapping is an error at that mapping.",
      "input": { "record": "anchor-on-mapping.yaml" },
      "expect": {
        "fails": true,
        "issues": [{ "code": "yaml-alias", "severity": "error", "path": "anchor-on-mapping.yaml", "at": "/m" }]
      }
    },
    {
      "id": "merge-key",
      "description": "A merge key << with an inline mapping, which js-yaml 4, PyYAML and ruamel.yaml merge (parser survey, section 4.2), is an error at the mapping that holds it, here the root.",
      "input": { "record": "merge-key.yaml" },
      "expect": {
        "fails": true,
        "issues": [{ "code": "yaml-merge-key", "severity": "error", "path": "merge-key.yaml", "at": "" }]
      }
    },
    {
      "id": "merge-key-in-nested-mapping",
      "description": "A merge key in a nested mapping is an error at that mapping.",
      "input": { "record": "nested-merge-key.yaml" },
      "expect": {
        "fails": true,
        "issues": [{ "code": "yaml-merge-key", "severity": "error", "path": "nested-merge-key.yaml", "at": "/m" }]
      }
    },
    {
      "id": "custom-tag",
      "description": "The local tag !foo on a scalar is an error at the tagged node; the yaml package only warns about it and keeps the value (parser survey, section 4.2).",
      "input": { "record": "custom-tag.yaml" },
      "expect": {
        "fails": true,
        "issues": [{ "code": "yaml-tag", "severity": "error", "path": "custom-tag.yaml", "at": "/a" }]
      }
    },
    {
      "id": "custom-tag-on-a-mapping",
      "description": "A custom tag on a flow mapping is an error at that mapping.",
      "input": { "record": "custom-tag-on-mapping.yaml" },
      "expect": {
        "fails": true,
        "issues": [{ "code": "yaml-tag", "severity": "error", "path": "custom-tag-on-mapping.yaml", "at": "/m" }]
      }
    },
    {
      "id": "verbatim-tag",
      "description": "A verbatim tag that names a global tag of its own, !<tag:example.com,2026:thing>, is a custom tag too.",
      "input": { "record": "verbatim-tag.yaml" },
      "expect": {
        "fails": true,
        "issues": [{ "code": "yaml-tag", "severity": "error", "path": "verbatim-tag.yaml", "at": "/a" }]
      }
    },
    {
      "id": "every-construct-reported",
      "description": "A record with .nan, a custom tag and an anchor reports all three, not only the first (§9.2).",
      "spec": ["4.1", "9.2"],
      "input": { "record": "several-constructs.yaml" },
      "expect": {
        "fails": true,
        "issues": [
          { "code": "yaml-non-finite", "severity": "error", "path": "several-constructs.yaml", "at": "/a" },
          { "code": "yaml-tag", "severity": "error", "path": "several-constructs.yaml", "at": "/b" },
          { "code": "yaml-alias", "severity": "error", "path": "several-constructs.yaml", "at": "/c" }
        ]
      }
    },
    {
      "id": "front-matter-infinity",
      "description": "Front matter is YAML, so .inf in it is outside the data model as in a YAML record, and the Markdown record fails parse at that field.",
      "spec": ["4.1", "5.3"],
      "input": { "record": "front-matter-infinity.md" },
      "expect": {
        "fails": true,
        "issues": [{ "code": "yaml-non-finite", "severity": "error", "path": "front-matter-infinity.md", "at": "/ratio" }]
      }
    },
    {
      "id": "one-document-with-markers",
      "description": "A file with one document between the markers --- and ... is a single document, so it is read; only several documents are an error.",
      "input": { "record": "explicit-document.yaml" },
      "expect": { "result": { "a": 1 } }
    },
    {
      "id": "core-schema-tag-str",
      "description": "Every explicit tag is an error, core schema tags included (§4.1): !!str 12 is yaml-tag at the tagged node, although the yaml package reads it as the string \"12\" and quoting already gives a string.",
      "input": { "record": "core-tag-str.yaml" },
      "expect": {
        "fails": true,
        "issues": [
          { "code": "yaml-tag", "severity": "error", "path": "core-tag-str.yaml", "at": "/a" }
        ]
      }
    },
    {
      "id": "core-schema-tag-int",
      "description": "!!int on a quoted scalar is an explicit core schema tag, an error; the yaml package reads it as the number 1.",
      "input": { "record": "core-tag-int.yaml" },
      "expect": {
        "fails": true,
        "issues": [
          { "code": "yaml-tag", "severity": "error", "path": "core-tag-int.yaml", "at": "/a" }
        ]
      }
    },
    {
      "id": "core-schema-tag-binary",
      "description": "!!binary is an explicit tag, an error; the yaml package resolves it to bytes even in its core schema (parser survey, section 4.2).",
      "input": { "record": "core-tag-binary.yaml" },
      "expect": {
        "fails": true,
        "issues": [
          { "code": "yaml-tag", "severity": "error", "path": "core-tag-binary.yaml", "at": "/a" }
        ]
      }
    },
    {
      "id": "core-schema-tag-set",
      "description": "!!set on a flow mapping is an explicit tag, an error at that mapping; the yaml package resolves it even in its core schema (parser survey, section 4.2).",
      "input": { "record": "core-tag-set.yaml" },
      "expect": {
        "fails": true,
        "issues": [
          { "code": "yaml-tag", "severity": "error", "path": "core-tag-set.yaml", "at": "/s" }
        ]
      }
    },
    {
      "id": "non-specific-tag",
      "description": "The non-specific tag ! (YAML 1.2.2, section 6.9.1) is an explicit tag too, so ! 12 is yaml-tag; the yaml package reads it as the string \"12\".",
      "spec": ["4.1", "YAML 1.2.2 6.9.1"],
      "input": { "record": "non-specific-tag.yaml" },
      "expect": {
        "fails": true,
        "issues": [
          { "code": "yaml-tag", "severity": "error", "path": "non-specific-tag.yaml", "at": "/a" }
        ]
      }
    },
    {
      "id": "quoted-merge-key-is-a-member",
      "description": "A quoted \"<<\" key is an ordinary member, not a merge key, since YAML 1.1 resolves its merge type only on a plain scalar (§4.1); the yaml package reads it the same way.",
      "input": { "record": "quoted-merge-key.yaml" },
      "expect": { "result": { "<<": { "a": 1 }, "b": 2 } }
    },
    {
      "id": "merge-key-with-a-scalar-value",
      "description": "A plain << key is a merge key whatever its value, so << with the value 1, which merges nothing, is still yaml-merge-key at the mapping (§4.1).",
      "input": { "record": "merge-key-scalar.yaml" },
      "expect": {
        "fails": true,
        "issues": [
          { "code": "yaml-merge-key", "severity": "error", "path": "merge-key-scalar.yaml", "at": "" }
        ]
      }
    },
    {
      "id": "alias-to-an-undefined-anchor",
      "description": "An alias to an anchor that is not defined, an error under YAML 1.2.2, section 7.1, is yaml-alias at the alias (Appendix D), not syntax-error; the yaml package throws ReferenceError from toJS.",
      "spec": ["4.1", "D", "YAML 1.2.2 7.1"],
      "input": { "record": "undefined-alias.yaml" },
      "expect": {
        "fails": true,
        "issues": [
          { "code": "yaml-alias", "severity": "error", "path": "undefined-alias.yaml", "at": "/a" }
        ]
      }
    },
    {
      "id": "several-documents",
      "description": "A file with two YAML documents is yaml-multiple-documents, which Appendix D attaches to the record, at its root.",
      "spec": ["4.1", "D"],
      "input": { "record": "several-documents.yaml" },
      "expect": {
        "fails": true,
        "issues": [
          { "code": "yaml-multiple-documents", "severity": "error", "path": "several-documents.yaml", "at": "" }
        ]
      }
    },
    {
      "id": "yaml-directive-1-1",
      "description": "A %YAML 1.1 directive is yaml-version-unsupported at the root (§4.4): the yaml package honors it and reads a: yes as true, so reading the file as 1.2 would change the value its author meant.",
      "spec": ["4.4", "D", "YAML 1.2.2 6.8.1"],
      "input": { "record": "yaml-directive-1-1.yaml" },
      "expect": {
        "fails": true,
        "issues": [
          { "code": "yaml-version-unsupported", "severity": "error", "path": "yaml-directive-1-1.yaml", "at": "" }
        ]
      }
    },
    {
      "id": "yaml-directive-1-3",
      "description": "A directive naming a higher minor version, %YAML 1.3, is rejected too (§4.4), although YAML 1.2.2, section 6.8.1, says to process it with a warning, as the yaml package does.",
      "spec": ["4.4", "D", "YAML 1.2.2 6.8.1"],
      "input": { "record": "yaml-directive-1-3.yaml" },
      "expect": {
        "fails": true,
        "issues": [
          { "code": "yaml-version-unsupported", "severity": "error", "path": "yaml-directive-1-3.yaml", "at": "" }
        ]
      }
    },
    {
      "id": "yaml-directive-1-2-accepted",
      "description": "A %YAML 1.2 directive is allowed, and the document is read with the core schema, so yes stays a string.",
      "spec": ["4.4"],
      "input": { "record": "yaml-directive-1-2.yaml" },
      "expect": { "result": { "a": "yes" } }
    },
    {
      "id": "yaml-directive-in-a-data-block",
      "description": "The rule holds in a yaml data block, whose %YAML 1.1 directive is yaml-version-unsupported at the data block's section (Appendix D).",
      "spec": ["4.4", "5.3", "D"],
      "input": { "record": "data-block-yaml-directive.md" },
      "expect": {
        "fails": true,
        "issues": [
          { "code": "yaml-version-unsupported", "severity": "error", "path": "data-block-yaml-directive.md", "at": "/$sections/0" }
        ]
      }
    }
  ]
}
