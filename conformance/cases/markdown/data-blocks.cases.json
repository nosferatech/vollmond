{
  "defaults": {
    "spec": ["5.3"],
    "profiles": ["read"],
    "operation": "parse",
    "input": { "store": "data-blocks" }
  },
  "cases": [
    {
      "id": "json-data",
      "description": "A json data fence right after a heading holds the section's fields.",
      "input": { "record": "json-data.md" },
      "expect": {
        "result": {
          "$title": "Record",
          "$body": "Root text.",
          "$sections": [{ "$title": "Part", "owner": "ana", "runs": [7, 9], "$body": "Part text." }]
        }
      }
    },
    {
      "id": "tilde-fence-without-blank-line",
      "description": "A fence of tildes is a fenced code block too, and one on the line right after the heading is a data block (CommonMark 0.31.2, 4.5).",
      "input": { "record": "tilde-no-blank.md" },
      "expect": {
        "result": {
          "$title": "Record",
          "$body": "Root text.",
          "$sections": [{ "$title": "Part", "owner": "ana", "$body": "Part text." }]
        }
      }
    },
    {
      "id": "blank-lines-between",
      "description": "Only blank lines between the heading and the fence, one of them holding only spaces (CommonMark 0.31.2, 2.1), still make the fence the data block.",
      "input": { "record": "blank-lines.md" },
      "expect": {
        "result": {
          "$title": "Record",
          "$body": "Root text.",
          "$sections": [{ "$title": "Part", "owner": "ana", "$body": "Part text." }]
        }
      }
    },
    {
      "id": "longer-fence",
      "description": "A four-backtick fence is closed only by a fence at least as long (CommonMark 0.31.2, 4.5), so the data block may hold a YAML string with a three-backtick fence in it.",
      "input": { "record": "longer-fence.md" },
      "expect": {
        "result": {
          "$title": "Record",
          "$body": "Root text.",
          "$sections": [{ "$title": "Part", "example": "```\ncode\n```\n", "$body": "Part text." }]
        }
      }
    },
    {
      "id": "nested-sections",
      "description": "Each section takes the data block right after its own heading, at any depth.",
      "input": { "record": "nested.md" },
      "expect": {
        "result": {
          "$title": "Record",
          "$body": "Root text.",
          "$sections": [
            {
              "$title": "Part",
              "owner": "ana",
              "$body": "Part text.",
              "$sections": [{ "$title": "Detail", "runs": ["R0007"], "$body": "Detail text." }]
            }
          ]
        }
      }
    },
    {
      "id": "level-1-section",
      "description": "A level-1 heading that is not the title heading is a section, so the data block after it holds that section's fields and is not misplaced, and the root's $body is the text before the first heading.",
      "input": { "record": "h1-section.md" },
      "expect": {
        "result": {
          "$body": "Root text.",
          "$sections": [{ "$title": "One", "owner": "ana", "$body": "One text." }]
        }
      }
    },
    {
      "id": "yaml-without-data-is-prose",
      "description": "A fence whose info string is yaml alone is an example, not a data block, so it is prose in $body.",
      "input": { "record": "yaml-without-data.md" },
      "expect": {
        "result": {
          "$title": "Record",
          "$body": "Root text.",
          "$sections": [{ "$title": "Part", "$body": "```yaml\nowner: ana\n```\n\nPart text." }]
        }
      }
    },
    {
      "id": "after-paragraph-is-prose",
      "description": "A yaml data fence after a paragraph is not right after the heading, so it is prose in $body.",
      "input": { "record": "after-paragraph.md" },
      "expect": {
        "result": {
          "$title": "Record",
          "$body": "Root text.",
          "$sections": [{ "$title": "Part", "$body": "Part text.\n\n```yaml data\nowner: ana\n```" }]
        }
      }
    },
    {
      "id": "after-html-comment-is-prose",
      "description": "An HTML comment is an HTML block (CommonMark 0.31.2, 4.6), not a blank line, so a yaml data fence after it is prose in $body.",
      "input": { "record": "after-comment.md" },
      "expect": {
        "result": {
          "$title": "Record",
          "$body": "Root text.",
          "$sections": [{ "$title": "Part", "$body": "<!-- owner below -->\n\n```yaml data\nowner: ana\n```" }]
        }
      }
    },
    {
      "id": "unknown-first-word",
      "spec": ["5.3", "9.1"],
      "description": "A fence right after a heading with data as the second word of its info string and toml as the first may come from a newer minor version, so it is a structural error at the section.",
      "input": { "record": "unknown-word.md" },
      "expect": {
        "fails": true,
        "issues": [{ "code": "feature-unsupported", "severity": "error", "path": "unknown-word.md", "at": "/$sections/0" }]
      }
    },
    {
      "id": "first-word-is-exact",
      "spec": ["5.3", "9.1"],
      "description": "YAML is a first word other than yaml or json, so YAML data right after a heading is a structural error like any unknown first word.",
      "input": { "record": "uppercase-word.md" },
      "expect": {
        "fails": true,
        "issues": [{ "code": "feature-unsupported", "severity": "error", "path": "uppercase-word.md", "at": "/$sections/0" }]
      }
    },
    {
      "id": "yaml-not-an-object",
      "description": "A data block must hold an object, so a YAML sequence in one is a structural error at its section.",
      "input": { "record": "yaml-list.md" },
      "expect": {
        "fails": true,
        "issues": [{ "code": "data-block-not-object", "severity": "error", "path": "yaml-list.md", "at": "/$sections/0" }]
      }
    },
    {
      "id": "json-not-an-object",
      "description": "A JSON string in a json data block is not an object, so it is a structural error at its section.",
      "input": { "record": "json-string.md" },
      "expect": {
        "fails": true,
        "issues": [{ "code": "data-block-not-object", "severity": "error", "path": "json-string.md", "at": "/$sections/0" }]
      }
    },
    {
      "id": "yaml-syntax-error",
      "spec": ["5.3", "9.2"],
      "description": "A yaml data block holding an unclosed flow sequence does not parse, which is a syntax error at the data block's section.",
      "input": { "record": "yaml-syntax-error.md" },
      "expect": {
        "fails": true,
        "issues": [{ "code": "syntax-error", "severity": "error", "path": "yaml-syntax-error.md", "at": "/$sections/0" }]
      }
    },
    {
      "id": "json-syntax-error",
      "spec": ["5.3", "9.2"],
      "description": "A json data block holding an unclosed object, which neither JSON nor YAML reads, is a syntax error at the data block's section.",
      "input": { "record": "json-syntax-error.md" },
      "expect": {
        "fails": true,
        "issues": [{ "code": "syntax-error", "severity": "error", "path": "json-syntax-error.md", "at": "/$sections/0" }]
      }
    },
    {
      "id": "dollar-key",
      "spec": ["5.3", "5.4"],
      "description": "A top-level $key in a data block is a structural error at that member of the section.",
      "input": { "record": "dollar-key.md" },
      "expect": {
        "fails": true,
        "issues": [{ "code": "dollar-member", "severity": "error", "path": "dollar-key.md", "at": "/$sections/0/$key" }]
      }
    },
    {
      "id": "after-the-title",
      "description": "The root's fields come only from the front matter, so a data block right after the title heading is a structural error at the root.",
      "input": { "record": "after-title.md" },
      "expect": {
        "fails": true,
        "issues": [{ "code": "data-block-misplaced", "severity": "error", "path": "after-title.md", "at": "" }]
      }
    },
    {
      "id": "empty-yaml-data-block",
      "description": "An empty yaml data block gives the section no fields.",
      "input": { "record": "empty-yaml.md" },
      "expect": { "result": { "$title": "Record", "$body": "Root text.", "$sections": [{ "$title": "Part", "$body": "Part text." }] } }
    },
    {
      "id": "empty-json-data-block",
      "spec": ["5.3", "5.4"],
      "description": "An empty json data block gives the section no fields, as an empty data block does.",
      "input": { "record": "empty-json.md" },
      "expect": { "result": { "$title": "Record", "$body": "Root text.", "$sections": [{ "$title": "Part", "$body": "Part text." }] } }
    },
    {
      "id": "second-data-block",
      "description": "A second data block right after the first is data-block-misplaced at its section, rather than prose whose fields would vanish.",
      "input": { "record": "second-block.md" },
      "expect": {
        "fails": true,
        "issues": [{ "code": "data-block-misplaced", "severity": "error", "path": "second-block.md", "at": "/$sections/0" }]
      }
    },
    {
      "id": "first-block-after-front-matter",
      "description": "A data fence as the first block after the front matter of a record without a title heading is data-block-misplaced at the root, since the root's fields come only from the front matter.",
      "input": { "record": "first-block-after-front-matter.md" },
      "expect": {
        "fails": true,
        "issues": [{ "code": "data-block-misplaced", "severity": "error", "path": "first-block-after-front-matter.md", "at": "" }]
      }
    },
    {
      "id": "first-block-of-the-file",
      "description": "A data fence as the first block of a file without front matter or a title heading is data-block-misplaced at the root.",
      "input": { "record": "first-block.md" },
      "expect": { "fails": true, "issues": [{ "code": "data-block-misplaced", "severity": "error", "path": "first-block.md", "at": "" }] }
    },
    {
      "id": "info-string-two-spaces",
      "spec": ["5.3", "CommonMark 0.31.2 4.5"],
      "description": "The info string is split into words on spaces and tabs, so yaml and data separated by two spaces make a data block.",
      "input": { "record": "info-two-spaces.md" },
      "expect": {
        "result": {
          "$title": "Record",
          "$body": "Root text.",
          "$sections": [{ "$title": "Part", "owner": "ana", "$body": "Part text." }]
        }
      }
    },
    {
      "id": "info-string-tab",
      "spec": ["5.3", "CommonMark 0.31.2 4.5"],
      "description": "A tab between yaml and data separates words as a space does, so the fence is a data block.",
      "input": { "record": "info-tab.md" },
      "expect": {
        "result": {
          "$title": "Record",
          "$body": "Root text.",
          "$sections": [{ "$title": "Part", "owner": "ana", "$body": "Part text." }]
        }
      }
    },
    {
      "id": "info-string-third-word",
      "spec": ["5.3", "9.1"],
      "description": "A third word after yaml data may be an option of a newer minor version, so the fence is feature-unsupported at its section.",
      "input": { "record": "info-third-word.md" },
      "expect": {
        "fails": true,
        "issues": [{ "code": "feature-unsupported", "severity": "error", "path": "info-third-word.md", "at": "/$sections/0" }]
      }
    },
    {
      "id": "info-string-letter-case",
      "description": "Words are compared case-sensitively, so Data is not the marker data, and the fence is prose.",
      "input": { "record": "info-letter-case.md" },
      "expect": {
        "result": {
          "$title": "Record",
          "$body": "Root text.",
          "$sections": [{ "$title": "Part", "$body": "```Yaml Data\nowner: ana\n```\n\nPart text." }]
        }
      }
    },
    {
      "id": "info-string-entity-reference",
      "spec": ["5.3", "CommonMark 0.31.2 4.5"],
      "description": "Words are compared on the source text, before CommonMark decodes the entity reference, so yaml&#32;data is one word and the fence is prose.",
      "input": { "record": "info-entity.md" },
      "expect": {
        "result": {
          "$title": "Record",
          "$body": "Root text.",
          "$sections": [{ "$title": "Part", "$body": "```yaml&#32;data\nowner: ana\n```\n\nPart text." }]
        }
      }
    },
    {
      "id": "json-unquoted-key",
      "spec": ["5.3", "9.2"],
      "description": "A json data block is read as JSON, so an unquoted key, which YAML would read, is a syntax error at the section.",
      "input": { "record": "json-unquoted-key.md" },
      "expect": {
        "fails": true,
        "issues": [{ "code": "syntax-error", "severity": "error", "path": "json-unquoted-key.md", "at": "/$sections/0" }]
      }
    },
    {
      "id": "json-trailing-comma",
      "spec": ["5.3", "9.2"],
      "description": "A trailing comma, which YAML's flow mappings allow and JSON does not, is a syntax error in a json data block.",
      "input": { "record": "json-trailing-comma.md" },
      "expect": {
        "fails": true,
        "issues": [{ "code": "syntax-error", "severity": "error", "path": "json-trailing-comma.md", "at": "/$sections/0" }]
      }
    },
    {
      "id": "json-comment",
      "spec": ["5.3", "9.2"],
      "description": "A # comment, which YAML allows and JSON does not, is a syntax error in a json data block.",
      "input": { "record": "json-comment.md" },
      "expect": {
        "fails": true,
        "issues": [{ "code": "syntax-error", "severity": "error", "path": "json-comment.md", "at": "/$sections/0" }]
      }
    },
    {
      "id": "dollar-section-members",
      "spec": ["5.3", "5.4"],
      "description": "The section members $title, $anchor, $tags, $body and $sections at the top of a data block are each dollar-member, and so is $schema, which is allowed only at the root.",
      "input": { "record": "dollar-section-members.md" },
      "expect": {
        "fails": true,
        "issues": [
          { "code": "dollar-member", "severity": "error", "path": "dollar-section-members.md", "at": "/$sections/0/$title" },
          { "code": "dollar-member", "severity": "error", "path": "dollar-section-members.md", "at": "/$sections/0/$anchor" },
          { "code": "dollar-member", "severity": "error", "path": "dollar-section-members.md", "at": "/$sections/0/$tags" },
          { "code": "dollar-member", "severity": "error", "path": "dollar-section-members.md", "at": "/$sections/0/$body" },
          { "code": "dollar-member", "severity": "error", "path": "dollar-section-members.md", "at": "/$sections/0/$sections" },
          { "code": "dollar-member", "severity": "error", "path": "dollar-section-members.md", "at": "/$sections/0/$schema" }
        ]
      }
    },
    {
      "id": "dollar-unknown",
      "spec": ["5.3", "9.1"],
      "description": "Another $ member at the top of a data block may be a section member of a newer minor version, so it is feature-unsupported at the member.",
      "input": { "record": "dollar-unknown.md" },
      "expect": {
        "fails": true,
        "issues": [{ "code": "feature-unsupported", "severity": "error", "path": "dollar-unknown.md", "at": "/$sections/0/$foo" }]
      }
    }
  ]
}
