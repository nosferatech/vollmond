      "input": {
        "config": "config-missing-schema.yaml",
        "address": "tickets/0001-first.md",
        "as": "singular"
      },
      "expect": {
        "fails": true,
        "issues": [
          {
            "code": "schema-invalid",
            "severity": "error",
            "path": null,
            "at": null
          }
        ]
      }
    },
    {
      "id": "refused-record-check",
      "spec": [
        "9.1",
        "D"
      ],
      "description": "check reports a collection whose schema file does not exist once, and still checks its records for everything else, here their file names (§9.1, decision U12).",
      "input": {
        "config": "config-missing-schema.yaml"
      },
      "expect": {
        "issues": [
          {
            "code": "schema-invalid",
            "severity": "error",
            "path": null,
            "at": null
