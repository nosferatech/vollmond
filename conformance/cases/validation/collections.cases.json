  "cases": [
    {
      "id": "filename-mismatch",
      "spec": [
        "3.2",
        "9.1",
        "D"
      ],
      "description": "A record of a collection whose file name does not match the collection's filename pattern gets filename-mismatch at its root; a record excluded from the collection and a file under an ignored glob are not checked against it, and the ignored file's syntax error is not reported either.",
      "expect": {
        "issues": [
          {
            "code": "filename-mismatch",
            "severity": "error",
            "path": "tickets/12-short.md",
            "at": ""
          },
          {
            "code": "heading-html",
            "severity": "warning",
            "path": "notes/html.md",
            "at": "/$sections/0"
          }
        ]
      }
    },
    {
      "id": "filename-matches",
      "spec": [
        "9.1",
        "D"
      ],
      "description": "A record whose file name matches its collection's filename pattern gets no filename-mismatch.",
      "input": {
        "records": [
          "tickets/0001-first.md"
        ]
      },
      "expect": {}
    },
    {
      "id": "every-member",
      "spec": [
        "9.1",
        "D"
      ],
      "description": "A configuration that gives every member, with a newer minor version, reads without a configuration issue, and its issues entry raises heading-html to an error (§9.1, decisions U10, U13 and U21).",
      "input": {
        "config": "config-full.yaml"
      },
      "expect": {
        "issues": [
          {
            "code": "filename-mismatch",
            "severity": "error",
            "path": "tickets/12-short.md",
            "at": ""
          },
          {
            "code": "heading-html",
            "severity": "error",
            "path": "notes/html.md",
            "at": "/$sections/0"
          }
        ]
      }
    },
